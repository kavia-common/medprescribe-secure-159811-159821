# Backend environment example for MedPrescribe (FastAPI)
# NOTE: Do not commit real secrets. Copy this file to ".env" and fill values for local development.
#
# The orchestrator will set environment variables for deployed environments automatically.

# --- App metadata (optional) ---
APP_NAME="MedPrescribe Backend"
API_DESCRIPTION="Backend API for creating and verifying medical prescriptions with Solana integration."
API_VERSION="0.1.0"

# --- Database (required in real deployments) ---
# Path to the SQLite database file. Can be absolute or relative to the container working directory.
# Example (local): ./data/medprescribe.db
SQLITE_DB="./myapp.db"

# --- Security (required in real deployments) ---
# Secret used to sign JWT access tokens. Use a strong, random value in real environments.
SECRET_KEY="PLEASE_CHANGE_ME"

# Access token expiry in minutes (optional, default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Algorithm used for JWT signing (optional, default HS256)
JWT_ALGORITHM="HS256"

# --- CORS configuration ---
# Comma-separated list of allowed origins.
# By default, the backend already allows:
# - http://localhost:3000
# - http://127.0.0.1:3000
# - https://vscode-internal-22919-beta.beta01.cloud.kavia.ai:3000
# You can override or add more origins here if needed.
#CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://your-preview-host.example.com:3000"

# Optional regex to allow matching dynamic preview hosts.
# The default allows localhost/127.0.0.1 (any port) and any *.cloud.kavia.ai host (any port).
#CORS_ORIGIN_REGEX="^https?:\/\/(localhost|127\.0\.0\.1)(:\d+)?$|^https:\/\/[a-z0-9\-\.]+\.cloud\.kavia\.ai(:\d+)?$"

# --- Frontend integration note (documentation) ---
# In the frontend (Next.js) project, set NEXT_PUBLIC_API_BASE to point to this backend.
# Examples:
#   NEXT_PUBLIC_API_BASE="http://localhost:8000"    # local dev if backend runs on 8000
#   NEXT_PUBLIC_API_BASE="https://vscode-internal-22919-beta.beta01.cloud.kavia.ai:3001"
#
# Frontend code should build API URLs like `${process.env.NEXT_PUBLIC_API_BASE}/auth/login`.
